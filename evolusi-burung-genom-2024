<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Peta Genom Evolusi 363 Spesies Burung (Nature, 2024)</title>
  <meta name="description" content="Analisis 63.430 lokus DNA dari 363 spesies burung mengungkap klade baru Elementaves dan ledakan evolusi pasca-kepunahan 66 juta tahun lalu." />
  <meta name="category" content="Zoologi" />
  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --muted: #475569;
      --primary: #0f766e;
      --primary-light: #ccfbf1;
      --amber: #d97706;
      --amber-light: #fef3c7;
      --sky: #0284c7;
      --sky-light: #e0f2fe;
      --border: #e2e8f0;
      --radius: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(180deg, #f0fdfa 0%, #f8fafc 35%, #fffbeb 100%);
      color: var(--text);
      line-height: 1.6;
      padding: 1.5rem 1rem 3.5rem;
    }

    .container {
      max-width: 820px;
      margin: 0 auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      text-decoration: none;
      color: var(--primary);
      font-weight: 600;
      font-size: 0.9rem;
      margin-bottom: 1.25rem;
    }

    .hero {
      background: linear-gradient(135deg, #0f766e 0%, #0369a1 100%);
      color: #ffffff;
      border-radius: 22px;
      padding: 2rem 1.75rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 12px 28px rgba(15, 118, 110, 0.18);
    }

    .badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }

    .badge {
      background: rgba(255, 255, 255, 0.18);
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.03em;
    }

    .hero h1 {
      font-size: clamp(1.5rem, 3.8vw, 2.15rem);
      line-height: 1.25;
      margin-bottom: 0.75rem;
    }

    .hero p {
      font-size: 0.96rem;
      opacity: 0.94;
      margin-bottom: 1.25rem;
    }

    .citation-box {
      background: rgba(15, 23, 42, 0.28);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 12px;
      padding: 0.9rem 1rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.84rem;
    }

    .copy-btn {
      background: #fbbf24;
      color: #0f172a;
      border: none;
      padding: 0.5rem 0.95rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .copy-btn:hover { transform: scale(1.03); opacity: 0.95; }

    /* Statistik Kunci */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 0.9rem;
      margin-bottom: 1.75rem;
    }

    .stat-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 1.15rem;
      text-align: center;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    }

    .stat-num {
      font-size: 1.7rem;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.15;
    }

    .stat-label {
      font-size: 0.82rem;
      color: var(--muted);
      margin-top: 0.3rem;
    }

    /* Section Card */
    .section {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 20px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
    }

    .section h2 {
      font-size: 1.22rem;
      margin-bottom: 0.35rem;
      color: var(--text);
    }

    .section-sub {
      font-size: 0.88rem;
      color: var(--muted);
      margin-bottom: 1.2rem;
    }

    /* Eksplorasi 4 Klade */
    .clade-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.1rem;
    }

    .clade-btn {
      padding: 0.5rem 0.95rem;
      border-radius: 999px;
      border: 1.5px solid var(--border);
      background: #f8fafc;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.84rem;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .clade-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
    }

    .clade-display {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 1.25rem;
      align-items: center;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.15rem;
    }

    @media (max-width: 560px) {
      .clade-display { grid-template-columns: 1fr; text-align: center; }
      .clade-svg-box { margin: 0 auto; }
    }

    .clade-svg-box {
      width: 112px;
      height: 112px;
      border-radius: 16px;
      background: #ffffff;
      border: 1.5px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .clade-info h3 {
      font-size: 1.08rem;
      color: var(--primary);
      margin-bottom: 0.3rem;
    }

    .clade-info p {
      font-size: 0.9rem;
      color: var(--muted);
      margin-bottom: 0.55rem;
    }

    .clade-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .mini-tag {
      background: var(--amber-light);
      color: #92400e;
      font-size: 0.76rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
    }

    /* Mekanisme Bertahap */
    .steps-nav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 0.6rem;
      margin-bottom: 1rem;
    }

    .step-btn {
      text-align: left;
      padding: 0.75rem 0.9rem;
      border-radius: 12px;
      border: 1.5px solid var(--border);
      background: #ffffff;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .step-btn strong {
      display: block;
      font-size: 0.78rem;
      color: var(--primary);
      margin-bottom: 0.15rem;
    }

    .step-btn span {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text);
    }

    .step-btn.active {
      background: var(--primary-light);
      border-color: var(--primary);
    }

    .step-detail {
      background: #f8fafc;
      border-left: 4px solid var(--primary);
      padding: 1rem 1.15rem;
      border-radius: 0 12px 12px 0;
      font-size: 0.92rem;
      color: var(--text);
    }

    /* Simulasi Visual Interaktif K-Pg */
    .sim-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin-bottom: 1.2rem;
    }

    .era-btn {
      flex: 1;
      min-width: 160px;
      padding: 0.7rem 0.9rem;
      border-radius: 12px;
      border: 1.5px solid var(--border);
      background: #ffffff;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      color: var(--muted);
      transition: all 0.2s ease;
    }

    .era-btn.active {
      background: #0284c7;
      border-color: #0284c7;
      color: #ffffff;
    }

    .sim-stage {
      background: #0f172a;
      color: #f8fafc;
      border-radius: 16px;
      padding: 1.3rem;
    }

    .sim-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .sim-era-badge {
      background: #f59e0b;
      color: #0f172a;
      font-weight: 800;
      font-size: 0.78rem;
      padding: 0.22rem 0.7rem;
      border-radius: 999px;
    }

    .meter-group {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .meter-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.84rem;
      margin-bottom: 0.3rem;
      color: #cbd5e1;
    }

    .meter-track {
      height: 12px;
      background: rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      overflow: hidden;
    }

    .meter-fill {
      height: 100%;
      border-radius: 999px;
      transition: width 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fill-ne { background: linear-gradient(90deg, #14b8a6, #2dd4bf); }
    .fill-mut { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .fill-brain { background: linear-gradient(90deg, #38bdf8, #818cf8); }

    .sim-note {
      font-size: 0.88rem;
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.08);
      padding: 0.85rem 1rem;
      border-radius: 10px;
    }

    /* Kuis */
    .quiz-item {
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.1rem;
      margin-bottom: 1rem;
      background: #f8fafc;
    }

    .quiz-q {
      font-weight: 700;
      font-size: 0.94rem;
      margin-bottom: 0.75rem;
    }

    .quiz-opts {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .opt-btn {
      text-align: left;
      padding: 0.65rem 0.9rem;
      border-radius: 10px;
      border: 1.5px solid var(--border);
      background: #ffffff;
      font-size: 0.88rem;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .opt-btn:hover:not(:disabled) { border-color: var(--primary); }
    .opt-btn.correct { background: #dcfce7; border-color: #16a34a; color: #14532d; font-weight: 700; }
    .opt-btn.wrong { background: #fee2e2; border-color: #dc2626; color: #7f1d1d; }

    .quiz-exp {
      margin-top: 0.65rem;
      font-size: 0.84rem;
      color: var(--muted);
      display: none;
    }

    .score-banner {
      margin-top: 1rem;
      padding: 0.95rem 1.15rem;
      border-radius: 12px;
      background: var(--primary-light);
      color: #0f766e;
      font-weight: 700;
      display: none;
      text-align: center;
    }

    footer {
      text-align: center;
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 1.5rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <a class="back-link" href="./">&larr; Kembali ke Katalog BioSci Brief</a>

    <header class="hero">
      <div class="badge-row">
        <span class="badge">🦉 Zoologi • Filogenomik Burung</span>
        <span class="badge">Nature (2024)</span>
      </div>
      <h1>Peta Genom 363 Spesies Burung Ungkap Ledakan Evolusi Pasca-Kepunahan Dinosaurus</h1>
      <p>Analisis 63.430 lokus DNA dari 92% famili burung dunia menyusun ulang silsilah burung modern dan menetapkan kelompok evolusi baru bernama <strong>Elementaves</strong>.</p>
      <div class="citation-box">
        <div>
          <strong>Referensi:</strong> Stiller, J., Feng, S., Chowdhury, A.-A., dkk. (2024). <em>Complexity of avian evolution revealed by family-level genomes.</em> Nature, 629(8013), 851–860. DOI: 10.1038/s41586-024-07323-1
        </div>
        <button class="copy-btn" id="copy-cite">Salin Sitasi</button>
      </div>
    </header>

    <!-- Statistik Kunci -->
    <section class="stats-grid">
      <div class="stat-card">
        <div class="stat-num">363</div>
        <div class="stat-label">Spesies burung yang diurutkan genomnya</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">92%</div>
        <div class="stat-label">Cakupan famili burung dunia (218 famili)</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">63.430</div>
        <div class="stat-label">Lokus DNA yang dianalisis</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">~66 Jt</div>
        <div class="stat-label">Tahun lalu, titik radiasi cepat K-Pg</div>
      </div>
    </section>

    <!-- Eksplorasi 4 Kelompok Utama Neoaves -->
    <section class="section">
      <h2>Eksplorasi 4 Kelompok Besar Burung Modern (Neoaves)</h2>
      <p class="section-sub">Klik masing-masing kelompok hasil revisi genomik Stiller dkk. (2024) untuk melihat anggota dan ciri adaptasinya.</p>
      <div class="clade-tabs" id="clade-tabs"></div>
      <div class="clade-display" id="clade-display"></div>
    </section>

    <!-- Mekanisme Bertahap -->
    <section class="section">
      <h2>Alur Riset: Bagaimana Pohon Kekerabatan Ini Disusun?</h2>
      <p class="section-sub">Klik tiap tahap untuk memahami cara peneliti memecahkan silsilah burung yang selama ini membingungkan.</p>
      <div class="steps-nav" id="steps-nav"></div>
      <div class="step-detail" id="step-detail"></div>
    </section>

    <!-- Simulasi Visual Interaktif -->
    <section class="section">
      <h2>Simulasi Dampak Kepunahan K-Pg pada Evolusi Burung</h2>
      <p class="section-sub">Pilih periode waktu di bawah ini untuk melihat perubahan parameter genetik dan biologis burung berdasarkan temuan genomik.</p>
      <div class="sim-controls">
        <button class="era-btn active" data-era="pre">1. Sebelum K-Pg (&gt;66 Jt Thn Lalu)</button>
        <button class="era-btn" data-era="post">2. Tepat Setelah K-Pg (~66 Jt Thn Lalu)</button>
        <button class="era-btn" data-era="modern">3. Stabilisasi &amp; Era Modern</button>
      </div>
      <div class="sim-stage">
        <div class="sim-header">
          <strong id="sim-title">Era Akhir Kapur (Sebelum Tumbukan Asteroid)</strong>
          <span class="sim-era-badge" id="sim-badge">Diversifikasi Terbatas</span>
        </div>
        <div class="meter-group">
          <div>
            <div class="meter-label"><span>Ukuran Populasi Efektif (<em>N<sub>e</sub></em>)</span><strong id="val-ne">Rendah</strong></div>
            <div class="meter-track"><div class="meter-fill fill-ne" id="bar-ne" style="width: 28%"></div></div>
          </div>
          <div>
            <div class="meter-label"><span>Laju Substitusi / Mutasi DNA</span><strong id="val-mut">Stabil</strong></div>
            <div class="meter-track"><div class="meter-fill fill-mut" id="bar-mut" style="width: 32%"></div></div>
          </div>
          <div>
            <div class="meter-label"><span>Ukuran Otak Relatif Burung</span><strong id="val-brain">Dasar</strong></div>
            <div class="meter-track"><div class="meter-fill fill-brain" id="bar-brain" style="width: 30%"></div></div>
          </div>
        </div>
        <div class="sim-note" id="sim-note">
          Sebelum kepunahan dinosaurus non-unggas, relung ekologi darat dan udara masih padat oleh kompetitor. Populasi nenek moyang Neoaves relatif kecil dengan laju perubahan genom yang lebih lambat.
        </div>
      </div>
    </section>

    <!-- Kuis Singkat Interaktif -->
    <section class="section">
      <h2>Kuis Singkat (3 Soal)</h2>
      <p class="section-sub">Uji pemahaman Anda terhadap temuan utama jurnal ini.</p>
      <div id="quiz-container"></div>
      <div class="score-banner" id="score-banner"></div>
    </section>

    <footer>
      BioSci Brief • Ringkasan Edukasi Sains Interaktif • Ilustrasi vektor asli dibuat untuk visualisasi klade
    </footer>
  </div>

  <script>
    // Salin Sitasi
    const citeText = "Stiller, J., Feng, S., Chowdhury, A.-A., Rivas-González, I., Duchêne, D. A., Fang, Q., ... & Zhang, G. (2024). Complexity of avian evolution revealed by family-level genomes. Nature, 629(8013), 851–860. https://doi.org/10.1038/s41586-024-07323-1";
    const copyBtn = document.getElementById("copy-cite");
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(citeText).then(() => {
        copyBtn.textContent = "Sitasi Tersalin!";
        setTimeout(() => copyBtn.textContent = "Salin Sitasi", 2000);
      });
    });

    // Data 4 Klade Neoaves
    const clades = [
      {
        id: "elementaves",
        name: "Elementaves (Kelompok Baru)",
        desc: "Kelompok besar baru yang diusulkan studi ini. Namanya merujuk pada kemampuan anggotanya menaklukkan berbagai elemen alam: air, udara, dan darat.",
        examples: ["Penguin", "Pelikan", "Kolibri", "Burung Pantai", "Bangau"],
        svg: `<svg viewBox="0 0 80 80" width="84" height="84" fill="none" stroke="#0284c7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 52c0-18 10-30 18-30s16 10 16 28c0 8-6 12-16 12s-18-2-18-10z" fill="#e0f2fe"/><path d="M56 32l10-3-8 7"/><circle cx="46" cy="30" r="2.2" fill="#0f172a"/><path d="M30 44c4 6 12 6 16 0"/></svg>`
      },
      {
        id: "telluraves",
        name: "Telluraves (Burung Darat Inti)",
        desc: "Mencakup mayoritas burung darat modern, termasuk pemangsa puncak, burung nokturnal, hingga kelompok burung pengicau dengan keragaman spesies tertinggi.",
        examples: ["Burung Hantu", "Elang", "Nuri", "Burung Pengicau", "Pelatuk"],
        svg: `<svg viewBox="0 0 80 80" width="84" height="84" fill="none" stroke="#0f766e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="40" cy="44" rx="18" ry="22" fill="#ccfbf1"/><circle cx="33" cy="34" r="5" fill="#fff"/><circle cx="47" cy="34" r="5" fill="#fff"/><circle cx="33" cy="34" r="2" fill="#0f172a"/><circle cx="47" cy="34" r="2" fill="#0f172a"/><path d="M38 40l2 4 2-4"/><path d="M24 24l6 6M56 24l-6 6"/></svg>`
      },
      {
        id: "mirandornithes",
        name: "Mirandornithes",
        desc: "Kelompok unik burung air berkaki panjang dan penyelam yang terpisah paling awal dari mayoritas cabang Neoaves lainnya.",
        examples: ["Flamingo", "Titihan (Grebe)"],
        svg: `<svg viewBox="0 0 80 80" width="84" height="84" fill="none" stroke="#db2777" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M28 46c0-8 10-12 20-10 8 2 12 8 10 14-4 6-18 6-26 2" fill="#fce7f3"/><path d="M32 38c-4-14 0-24 10-24 4 0 6 3 4 6"/><path d="M40 52v18M46 52l-4 10 6 2"/></svg>`
      },
      {
        id: "columbaves",
        name: "Columbaves",
        desc: "Kelompok yang menyatukan burung darat dan semi-terestrial seperti merpati, kukuk, dan kalkun padang (bustard).",
        examples: ["Merpati", "Kukuk", "Turaco", "Sandgrouse"],
        svg: `<svg viewBox="0 0 80 80" width="84" height="84" fill="none" stroke="#d97706" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 46c8-4 14-16 24-18 8-2 14 4 14 10 0 10-10 18-24 18-6 0-11-4-14-10z" fill="#fef3c7"/><path d="M56 36l8 2-6 4"/><circle cx="48" cy="35" r="2" fill="#0f172a"/></svg>`
      }
    ];

    let activeClade = clades[0].id;
    const cladeTabsEl = document.getElementById("clade-tabs");
    const cladeDisplayEl = document.getElementById("clade-display");

    function renderClades() {
      cladeTabsEl.innerHTML = clades.map(c => `
        <button class="clade-btn ${c.id === activeClade ? "active" : ""}" data-id="${c.id}">${c.name}</button>
      `).join("");

      const current = clades.find(c => c.id === activeClade);
      cladeDisplayEl.innerHTML = `
        <div class="clade-svg-box">${current.svg}</div>
        <div class="clade-info">
          <h3>${current.name}</h3>
          <p>${current.desc}</p>
          <div class="clade-tags">
            ${current.examples.map(ex => `<span class="mini-tag">${ex}</span>`).join("")}
          </div>
        </div>
      `;

      cladeTabsEl.querySelectorAll(".clade-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          activeClade = btn.dataset.id;
          renderClades();
        });
      });
    }
    renderClades();

    // Mekanisme Bertahap
    const steps = [
      {
        title: "1. Koleksi 363 Genom",
        text: "Tim mengumpulkan data genom lengkap dari 363 spesies burung (218 famili). Cakupan 92% famili burung dunia ini jauh lebih rapat dibanding studi sebelumnya sehingga mengurangi kesalahan penarikan cabang evolusi."
      },
      {
        title: "2. Seleksi 63.430 Lokus",
        text: "Peneliti membandingkan 63.430 lokus DNA dan menemukan bahwa segmen intergenik (non-pengkode) memberi sinyal evolusi yang lebih jernih dibanding gen pengkode protein (ekson) yang sering terdistorsi oleh seleksi alam."
      },
      {
        title: "3. Atasi Konflik Gen (ILS)",
        text: "Karena burung berevolusi sangat cepat setelah kepunahan K-Pg, banyak gen berbeda menghasilkan pohon yang saling bertentangan (incomplete lineage sorting). Metode analisis koalesen dipakai untuk menyatukan puluhan ribu pohon gen menjadi satu pohon spesies yang konsisten."
      },
      {
        title: "4. Kalibrasi Waktu Fosil",
        text: "Dengan mengaitkan data genom pada catatan fosil yang terverifikasi, peneliti memastikan bahwa sebagian besar cabang utama Neoaves memisah tepat setelah batas kepunahan K-Pg sekitar 66 juta tahun lalu."
      }
    ];

    let activeStep = 0;
    const stepsNavEl = document.getElementById("steps-nav");
    const stepDetailEl = document.getElementById("step-detail");

    function renderSteps() {
      stepsNavEl.innerHTML = steps.map((s, idx) => `
        <button class="step-btn ${idx === activeStep ? "active" : ""}" data-idx="${idx}">
          <strong>Tahap ${idx + 1}</strong>
          <span>${s.title.replace(/^\d+\.\s*/, "")}</span>
        </button>
      `).join("");

      stepDetailEl.textContent = steps[activeStep].text;

      stepsNavEl.querySelectorAll(".step-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          activeStep = Number(btn.dataset.idx);
          renderSteps();
        });
      });
    }
    renderSteps();

    // Simulasi K-Pg
    const eras = {
      pre: {
        title: "Era Akhir Kapur (Sebelum Tumbukan Asteroid)",
        badge: "Diversifikasi Terbatas",
        ne: { w: "28%", label: "Rendah" },
        mut: { w: "32%", label: "Stabil" },
        brain: { w: "30%", label: "Dasar" },
        note: "Sebelum kepunahan dinosaurus non-unggas, relung ekologi darat dan udara masih padat oleh kompetitor. Populasi nenek moyang Neoaves relatif kecil dengan laju perubahan genom yang lebih lambat."
      },
      post: {
        title: "Tepat Setelah Batas K-Pg (~66 Juta Tahun Lalu)",
        badge: "Lonjakan Evolusi Cepat",
        ne: { w: "92%", label: "Meningkat Tajam" },
        mut: { w: "88%", label: "Sangat Cepat" },
        brain: { w: "82%", label: "Membesar Cepat" },
        note: "Kepunahan massal membuka ribuan relung ekologi kosong. Data genom Stiller dkk. (2024) merekam lonjakan tajam ukuran populasi efektif (Ne), laju mutasi DNA, dan ukuran otak relatif burung yang memicu lahirnya 4 klade utama Neoaves."
      },
      modern: {
        title: "Era Modern (>10.000 Spesies Burung)",
        badge: "Tersebar di Semua Habitat",
        ne: { w: "68%", label: "Bervariasi per Famili" },
        mut: { w: "55%", label: "Terdiferensiasi" },
        brain: { w: "90%", label: "Tinggi (Nuri & Pengicau)" },
        note: "Cabang-cabang Neoaves kini menempati hampir seluruh ekosistem Bumi—dari laut dalam (penguin di Elementaves) hingga kanopi hutan (burung hantu dan pengicau di Telluraves)."
      }
    };

    document.querySelectorAll(".era-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".era-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const data = eras[btn.dataset.era];
        document.getElementById("sim-title").textContent = data.title;
        document.getElementById("sim-badge").textContent = data.badge;
        document.getElementById("bar-ne").style.width = data.ne.w;
        document.getElementById("val-ne").textContent = data.ne.label;
        document.getElementById("bar-mut").style.width = data.mut.w;
        document.getElementById("val-mut").textContent = data.mut.label;
        document.getElementById("bar-brain").style.width = data.brain.w;
        document.getElementById("val-brain").textContent = data.brain.label;
        document.getElementById("sim-note").textContent = data.note;
      });
    });

    // Kuis Interaktif
    const quizData = [
      {
        q: "1. Apa nama kelompok besar burung baru yang ditetapkan dalam studi Stiller dkk. (2024)?",
        options: ["Telluraves", "Elementaves", "Paleognathae"],
        correct: 1,
        exp: "Elementaves adalah klade baru yang menyatukan burung yang beradaptasi di air, udara, dan darat seperti penguin, pelikan, burung pantai, dan kolibri."
      },
      {
        q: "2. Bagian DNA mana yang terbukti memberi sinyal pohon evolusi lebih stabil dalam penelitian ini?",
        options: ["Daerah intergenik (non-pengkode)", "Hanya DNA mitokondria", "Gen pengkode protein (ekson) saja"],
        correct: 0,
        exp: "Daerah intergenik (non-pengkode) lebih sedikit terpengaruh oleh bias seleksi alam dibandingkan ekson, sehingga menghasilkan pohon kekerabatan yang lebih konsisten."
      },
      {
        q: "3. Apa yang terjadi pada ukuran populasi efektif (Ne) dan ukuran otak relatif burung tepat setelah kepunahan K-Pg?",
        options: ["Keduanya menurun drastis", "Tidak mengalami perubahan", "Keduanya mengalami lonjakan tajam"],
        correct: 2,
        exp: "Terbukanya relung ekologi pasca-kepunahan 66 juta tahun lalu memicu lonjakan tajam pada ukuran populasi efektif, laju mutasi DNA, dan ukuran otak relatif burung."
      }
    ];

    const quizContainer = document.getElementById("quiz-container");
    const scoreBanner = document.getElementById("score-banner");
    let answered = 0;
    let score = 0;

    quizData.forEach((item, qIdx) => {
      const box = document.createElement("div");
      box.className = "quiz-item";
      box.innerHTML = `
        <div class="quiz-q">${item.q}</div>
        <div class="quiz-opts">
          ${item.options.map((opt, oIdx) => `<button class="opt-btn" data-o="${oIdx}">${opt}</button>`).join("")}
        </div>
        <div class="quiz-exp" id="exp-${qIdx}"></div>
      `;
      quizContainer.appendChild(box);

      const btns = box.querySelectorAll(".opt-btn");
      const expEl = box.querySelector(`#exp-${qIdx}`);

      btns.forEach(btn => {
        btn.addEventListener("click", () => {
          const chosen = Number(btn.dataset.o);
          btns.forEach(b => b.disabled = true);
          if (chosen === item.correct) {
            btn.classList.add("correct");
            score++;
          } else {
            btn.classList.add("wrong");
            btns[item.correct].classList.add("correct");
          }
          expEl.textContent = item.exp;
          expEl.style.display = "block";
          answered++;
          if (answered === quizData.length) {
            scoreBanner.textContent = `Skor Anda: ${score} dari ${quizData.length} soal benar!`;
            scoreBanner.style.display = "block";
          }
        });
      });
    });
  </script>
</body>
</html>
